# Base locale (Docker). Valeurs pour le développement uniquement : changez les mots
# de passe, et reportez le même mot de passe dans DATABASE_URL de backend/.env.
MARIADB_DATABASE=university_system
MARIADB_USER=ur_tana
MARIADB_PASSWORD=local_dev_password_change_me
MARIADB_ROOT_PASSWORD=local_root_password_change_me
MARIADB_PORT=3307

# Site (frontend) : adresse de l'API, lue au moment du build (npm run build).
# Laissez vide en local (http://localhost:4000). Production :
#   VITE_API_URL=https://api.votre-domaine.com
VITE_API_URL=
