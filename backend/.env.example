# ─────────────────────────────────────────────────────────────────────────────
# Configuration de l'API. En local : copiez ce fichier en .env.
# En production (Hostinger) : saisissez ces variables dans les paramètres de
# l'application Node.js, pas dans un fichier. Guide complet : DEPLOIEMENT.md
# ─────────────────────────────────────────────────────────────────────────────

# development en local, production en ligne
NODE_ENV=development
# Port d'écoute (en ligne, l'hébergeur le fournit lui-même)
PORT=4000

# Adresse(s) du site autorisées à appeler l'API, séparées par des virgules.
#   Production : CORS_ORIGIN=https://univreference.com,https://www.univreference.com
CORS_ORIGIN=http://localhost:8080

# Adresses publiques : APP_URL = le site (liens des e-mails), API_URL = cette API
# (photos, QR codes, lettres). Obligatoires en production.
#   APP_URL=https://univreference.com
#   API_URL=https://api.univreference.com
APP_URL=http://localhost:8081
API_URL=http://localhost:4000

# Base MySQL / MariaDB (locale : service mariadb du compose.yaml à la racine).
# Sur Hostinger : hPanel → Bases de données MySQL, puis
#   mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/NOM_DE_LA_BASE   (HOTE : souvent localhost)
# Encodez les caractères spéciaux du mot de passe (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL="mysql://ur_tana:local_dev_password_change_me@localhost:3307/university_system"

# Secrets des sessions : deux valeurs longues, aléatoires et DIFFÉRENTES.
# Générez-les avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Le serveur refuse de démarrer en production avec les valeurs d'exemple.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxxxxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# Fichiers déposés (vidéos, documents, photos, CV). En production, choisissez des
# dossiers HORS du dossier de l'application : un nouveau déploiement Git le remplace.
#   UPLOADS_DIR=/home/VOTRE_COMPTE/ur-fichiers/uploads
#   PRIVATE_UPLOADS_DIR=/home/VOTRE_COMPTE/ur-fichiers/private
UPLOADS_DIR=
PRIVATE_UPLOADS_DIR=

# Premier Super administrateur, créé au premier démarrage si ce compte n'existe pas.
# Retirez ces deux lignes une fois connecté. Mot de passe : 12 caractères minimum.
# En local, préférez « npm run create:admin » (mot de passe saisi sans être affiché).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Envoi d'e-mails (accès des nouveaux comptes, mot de passe oublié). Laissez SMTP_HOST
# vide en local : les e-mails sont alors écrits dans backend/logs/emails/ au lieu d'être envoyés.
# Messagerie Hostinger : SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (SSL automatique),
# SMTP_USER = l'adresse complète (ex. contact@univreference.com), SMTP_PASS = son mot de passe.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Université Références <contact@univreference.com>"
