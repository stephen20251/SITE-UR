# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8080

# Base MySQL / MariaDB (locale : service mariadb du compose.yaml à la racine).
# Sur Hostinger : hPanel → Bases de données MySQL, puis
#   mysql://UTILISATEUR:MOT_DE_PASSE@localhost:3306/NOM_DE_LA_BASE
# Encodez les caractères spéciaux du mot de passe (@ → %40, # → %23, / → %2F).
DATABASE_URL="mysql://ur_tana:local_dev_password_change_me@localhost:3307/university_system"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxxxxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BCRYPT_ROUNDS=12

# Adresse publique du site (liens contenus dans les e-mails)
APP_URL=http://localhost:8081

# Envoi d'e-mails. Laissez SMTP_HOST vide en local : les e-mails sont alors écrits
# dans backend/logs/emails/ au lieu d'être envoyés.
# Avec Gmail : activez la validation en 2 étapes du compte, créez un « mot de passe
# d'application » (https://myaccount.google.com/apppasswords) et mettez-le dans SMTP_PASS.
# N'utilisez jamais le mot de passe normal du compte Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Université Références <votre.adresse@gmail.com>"
